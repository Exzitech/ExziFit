<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde Android (Google) et transfert vers un nouveau téléphone, Android 12 et plus :
     seul le dossier de données de l'app (fichiers.rs, `donnees/`), copies du jour comprises.
     Le reste du dossier privé (WebView) est exclu : au-delà de 25 Mo, toute la sauvegarde échoue. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="donnees/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="donnees/" />
    </device-transfer>
</data-extraction-rules>
